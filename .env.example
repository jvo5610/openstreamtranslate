# URLs visibles desde el contenedor app. Con un túnel SSH local, Docker Desktop
# resuelve host.docker.internal al host que publica 18080/18081.
ASR_URL=http://host.docker.internal:18081
TRANSLATION_URL=http://host.docker.internal:18080

# Dirección inicial; Studio permite cambiarla por sesión.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=es

# Cadencia del scheduler. Mantener LIVE_UPDATE_SECONDS < LIVE_FINAL_SECONDS.
LIVE_UPDATE_SECONDS=1.5
LIVE_FINAL_SECONDS=3
LIVE_MAX_FINAL_SECONDS=4.5
LIVE_OVERLAP_SECONDS=0.75
LIVE_CONTEXT_CHARACTERS=700

# Reintentos breves para fallas transitorias de los servicios GPU.
MODEL_MAX_ATTEMPTS=3
MODEL_REQUEST_TIMEOUT_SECONDS=30
MODEL_RETRY_BASE_SECONDS=0.25
MODEL_RETRY_MAX_SECONDS=2

# Estado compartido y margen para sincronizar reproductores en la simulación.
REDIS_URL=redis://redis:6379/0
SIMULATOR_START_DELAY_SECONDS=2
